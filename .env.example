# Copy to .env for local testing, then: npm run server (terminal 1) + npm run start (terminal 2)
#
# Amplify Console → Environment variables (same name):
#   VITE_SOCKET_SERVER_URL = https://YOUR-SOCKET-SERVER-URL
# Must be HTTPS if your Amplify app is HTTPS. Redeploy after changing.
#
# The socket server is separate from the static web app — deploy server/index.js
# to a Node host (Lightsail, Railway, etc.) on port 3000, then put that public URL here.

VITE_SOCKET_SERVER_URL=
